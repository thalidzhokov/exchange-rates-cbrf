{
  "name": "thalidzhokov/exchange-rates-cbrf",
  "description": "PHP class for daily exchange rates of the Central Bank of Russia by ISO 4217 alphabetic and numeric codes, with the ruble and cross rates",
  "keywords": [
    "exchange rates",
    "currency rates",
    "currencies",
    "cbr",
    "cbrf",
    "cbr.ru",
    "central bank of russia",
    "bank of russia",
    "ruble",
    "rub",
    "cross rate",
    "iso 4217",
    "daily rates"
  ],
  "require": {
    "php": "^5.4 || ^7.0 || ^8.0",
    "ext-soap": "*",
    "ext-simplexml": "*"
  },
  "suggest": {
    "ext-openssl": "Needed to load the CBR WSDL over HTTPS"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "archive": {
    "exclude": [
      "/tests",
      "/phpunit.xml.dist"
    ]
  },
  "autoload": {
    "classmap": [
      "ExchangeRatesCBRF.php"
    ]
  },
  "license": "GPL-3.0-or-later",
  "scripts": {
    "test": "phpunit"
  },
  "authors": [
    {
      "name": "Aleksey Vaganov"
    },
    {
      "name": "Albert Thalidzhokov"
    }
  ]
}
