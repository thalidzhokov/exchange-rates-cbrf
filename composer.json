{
  "name": "thalidzhokov/exchange-rates-cbrf",
  "description": "ExchangeRatesCBRF Class to get exchange rates of the Central Bank of Russia",
  "keywords": [
    "exchange rates",
    "currencies",
    "cbr",
    "cbrf",
    "central bank of russia"
  ],
  "require": {
    "php": "^5.4 || ^7.0 || ^8.0",
    "ext-soap": "*",
    "ext-simplexml": "*"
  },
  "suggest": {
    "ext-openssl": "Needed to load the CBR WSDL over HTTPS"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "archive": {
    "exclude": [
      "/tests",
      "/phpunit.xml.dist",
      "/.github",
      "/.vscode"
    ]
  },
  "autoload": {
    "classmap": [
      "ExchangeRatesCBRF.php"
    ]
  },
  "license": "GPL-3.0-or-later",
  "scripts": {
    "test": "phpunit"
  },
  "authors": [
    {
      "name": "Aleksey Vaganov"
    },
    {
      "name": "Albert Thalidzhokov"
    }
  ]
}
